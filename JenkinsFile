pipeline{
    agent any
    
    stages{
        stage('retrieve code from Github'){
            steps{
                git branch: 'main', url: 'https://github.com/beeks-bk/javaapp-maven.git'
            }
        }
        stage('build using Maven'){
            steps{
                bat 'mvn clean package'
            }
        }
        stage('test using maven'){
            steps{
                bat 'mvn test'
            }
        }
       stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv('SonarQube') {
                    withCredentials([string(credentialsId: 'sonartoken', variable: 'SONAR_TOKEN')]) {
                        bat 'mvn sonar:sonar -Dsonar.projectKey=javaapp-maven -Dsonar.token=%SONAR_TOKEN%'
                    }
                }
            }
        }
    stage('Docker Build') {
        steps {
             bat 'docker build -t javaapp .'
    }
}

        stage('Scanning vulnerabilities using Trivy') {
             steps {
                  bat 'trivy.exe image --timeout 10m javaapp:latest'
             }
    }
    }
}
