pipeline {
    agent any

    tools {
        maven 'mvn'
    }

    stages {

        stage('retrieving code') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/beeks-bk/javaapp-maven.git'
            }
        }

        stage('Maven Build') {
            steps {
                bat 'mvn clean package'
            }
        }

        stage('Maven test') {
            steps {
                bat 'mvn test'
            }
        }

        stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv('SonarQube') {
                    withCredentials([string(credentialsId: 'sonartoken', variable: 'SONAR_TOKEN')]) {
                        bat 'mvn sonar:sonar -Dsonar.projectKey=javaapp-maven -Dsonar.token=%SONAR_TOKEN%'
                    }
                }
            }
        }

        stage('Docker Build') {
    steps {
        bat '"C:\\Users\\ADMIN\\AppData\\Local\\Programs\\DockerDesktop\\resources\\bin\\docker.exe" build -t javaapp .'
    }
}

stage('Trivy Scan') {
    steps {
        bat 'trivy.exe image --timeout 10m javaapp:latest'
    }
}
    }
}
